{
  "name": "finder",
  "version": "4.0.0",
  "description": "explorer",
  "main": "src/server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "download_samples": "node src/scripts/downloadSamples.js",
    "openapi": "node src/scripts/writeOpenApi.js",
    "dev": "node --watch src/server.js",
    "format": "prettier --config ../prettier.config.cjs --write .",
    "format:check": "prettier --config ../prettier.config.cjs --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "start": "node --watch src/server.js"
  },
  "author": "Vikram Soni",
  "license": "ISC",
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@tus/file-store": "^2.1.0",
    "@tus/server": "^2.4.1",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exif-reader": "^2.0.3",
    "exiftool-vendored": "^37.0.0",
    "express": "^5.2.1",
    "express-openid-connect": "^2.20.2",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "p-limit": "^3.1.0",
    "p-queue": "^7.4.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "sharp": "^0.35.5",
    "uuid": "^13.0.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vitest": "^4.1.11"
  }
}
